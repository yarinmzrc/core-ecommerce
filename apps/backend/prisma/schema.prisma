generator client {
  provider = "prisma-client"
  binaryTargets = ["native", "linux-musl", "rhel-openssl-3.0.x"]  
  output   = "./generated/prisma"
}

datasource db {
  provider = "mongodb"
  url = env("DATABASE_URL")
}

model User {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  email String @unique
  passwordHash String
  role Role @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
}

type Image {
  url String
  publicId String
}

model Product {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name String
  slug String @unique
  basePrice Int
  description String
  images Image[]
  isAvailableForSale Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoryId String @db.ObjectId
  category Category @relation(fields: [categoryId], references: [id])

  variants ProductVariant[]
  options ProductOption[]

  orderItems OrderItem[]
}

model ProductOption {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name String
  // Option can be linked to a template OR fully custom
  templateId String? @db.ObjectId
  template OptionTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  // Overrides: only fields that differ from the template, or full data if custom
  overrides Json?

  productId String @db.ObjectId
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  sku String? @unique
  price Int
  stockQuantity Int @default(0)
  images Image[]
  selectedOptions Json

  productId String @db.ObjectId
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  orderItems OrderItem[]
}

enum AppType {
  FASHION
  FOOD
  CATERING
}

enum OptionInputType {
  TEXT
  NUMBER
  BOOLEAN
}

enum OptionUIType {
  SELECT
  MULTI_SELECT
  BOOLEAN
}

enum OptionPricingStrategy {
  NONE
  ADDON
  PER_UNIT
}

model OptionTemplate {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name String
  appType AppType
  inputType OptionInputType  
  uiType OptionUIType       
  pricingStrategy OptionPricingStrategy
  values Json    // array of option values { value, label, priceDelta }
  isActive Boolean @default(true)
  required Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productOptions ProductOption[]  // optional: which products this template is used for
}

model Category {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  imageUrl String
  imagePublicId String
  
  products Product[]
}

model Order {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  pricePaid Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status OrderStatus @default(PENDING)

  guestEmail String
  guestName String?
  guestPhone String?

  orderItems OrderItem[]
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  FULFILLED
}

model OrderItem {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name String
  variantName String?
  price Int
  quantity Int

  createdAt DateTime @default(now())

  orderId String @db.ObjectId
  productId String @db.ObjectId

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  variantId String? @db.ObjectId
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
}
